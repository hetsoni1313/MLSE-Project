# =============================================================================
# LLMOps Governance Platform - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=llmops-governance
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# API Gateway
# -----------------------------------------------------------------------------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=1

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL (production)
DATABASE_URL=postgresql+asyncpg://llmops:llmops_password@localhost:5432/llmops_governance

# SQLite (development fallback)
SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/llmops_governance.db

# Which database backend to use: "postgres" or "sqlite"
DATABASE_BACKEND=sqlite

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# -----------------------------------------------------------------------------
# LLM Provider Base URLs (optional overrides)
# -----------------------------------------------------------------------------
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
DEFAULT_MODEL=gpt-3.5-turbo
DEFAULT_MAX_TOKENS=256
DEFAULT_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# Governance Guardrails
# -----------------------------------------------------------------------------
# Cost thresholds (USD)
COST_ALERT_THRESHOLD=10.00
COST_HARD_LIMIT=50.00
MONTHLY_BUDGET_LIMIT=500.00

# Latency thresholds (milliseconds)
LATENCY_P50_TARGET_MS=500
LATENCY_P95_TARGET_MS=2000
LATENCY_P99_TARGET_MS=5000
LATENCY_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000

# -----------------------------------------------------------------------------
# MLflow Experiment Tracking
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=llmops-banking77
MLFLOW_REGISTRY_URI=sqlite:///./data/mlflow_registry.db

# -----------------------------------------------------------------------------
# Streamlit Dashboard
# -----------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# Data Paths
# -----------------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
ARTIFACTS_DIR=artifacts

# -----------------------------------------------------------------------------
# Docker / Deployment
# -----------------------------------------------------------------------------
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=llmops-governance
DOCKER_TAG=latest

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL_SECONDS=30
